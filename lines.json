[
  {"id": "c01_greet",  "voice": "c01", "kind": "greet",  "text": "Hello? Is that you, Gerald?"},
  {"id": "c01_hangup", "voice": "c01", "kind": "hangup", "text": "Gerald doesn't live here anymore."},
  {"id": "c01_sale",   "voice": "c01", "kind": "sale",   "text": "Oh, how lovely. Put me down for two, dear."},
  {"id": "c02_greet",  "voice": "c02", "kind": "greet",  "text": "Yeah. What."},
  {"id": "c02_hangup", "voice": "c02", "kind": "hangup", "text": "Nope."},
  {"id": "c02_nosale", "voice": "c02", "kind": "nosale", "text": "I'm gonna stop you right there."},
  {"id": "c03_greet",  "voice": "c03", "kind": "greet",  "text": "Yo, who's this?"},
  {"id": "c03_hangup", "voice": "c03", "kind": "hangup", "text": "Ha, no. Bye."},
  {"id": "c03_sale",   "voice": "c03", "kind": "sale",   "text": "Dude. Yes. Sign me up."},
  {"id": "c04_greet",  "voice": "c04", "kind": "greet",  "text": "This is Linda. Make it quick."},
  {"id": "c04_hangup", "voice": "c04", "kind": "hangup", "text": "Take me off your list."},
  {"id": "c04_nosale", "voice": "c04", "kind": "nosale", "text": "Send me something in writing."},
  {"id": "c05_greet",  "voice": "c05", "kind": "greet",  "text": "How did you get this number?"},
  {"id": "c05_hangup", "voice": "c05", "kind": "hangup", "text": "I know what you are."},
  {"id": "c05_nosale", "voice": "c05", "kind": "nosale", "text": "My nephew says never buy anything on the phone."},
  {"id": "c06_greet",  "voice": "c06", "kind": "greet",  "text": "Hello? Mom's not home."},
  {"id": "c06_hangup", "voice": "c06", "kind": "hangup", "text": "Uh, no?"},
  {"id": "c06_nosale", "voice": "c06", "kind": "nosale", "text": "I'm not allowed to buy stuff."},
  {"id": "c07_greet",  "voice": "c07", "kind": "greet",  "text": "Oh. Um. Hello?"},
  {"id": "c07_hangup", "voice": "c07", "kind": "hangup", "text": "Sorry, sorry, wrong... sorry."},
  {"id": "c07_sale",   "voice": "c07", "kind": "sale",   "text": "I, I guess I could. Yes. Okay."},
  {"id": "c08_greet",  "voice": "c08", "kind": "greet",  "text": "Mmh. I was asleep."},
  {"id": "c08_hangup", "voice": "c08", "kind": "hangup", "text": "Call back never."},
  {"id": "c08_sale",   "voice": "c08", "kind": "sale",   "text": "Fine. Whatever it is. Yes."},
  {"id": "c09_greet",  "voice": "c09", "kind": "greet",  "text": "Well hi there, sugar!"},
  {"id": "c09_hangup", "voice": "c09", "kind": "hangup", "text": "Oh, honey, no."},
  {"id": "c09_sale",   "voice": "c09", "kind": "sale",   "text": "You talked me into it. You're good."},
  {"id": "c10_greet",  "voice": "c10", "kind": "greet",  "text": "Hello? Sorry, I've got a cold."},
  {"id": "c10_hangup", "voice": "c10", "kind": "hangup", "text": "I can't. I'm dying. Bye."},
  {"id": "c10_nosale", "voice": "c10", "kind": "nosale", "text": "Can you call back when I can breathe?"},
  {"id": "c11_greet",  "voice": "c11", "kind": "greet",  "text": "Shh. The baby's asleep."},
  {"id": "c11_hangup", "voice": "c11", "kind": "hangup", "text": "If you wake her, I will find you."},
  {"id": "c11_nosale", "voice": "c11", "kind": "nosale", "text": "Not today. Please don't call again."},
  {"id": "c12_greet",  "voice": "c12", "kind": "greet",  "text": "Yello! Talk to me!"},
  {"id": "c12_hangup", "voice": "c12", "kind": "hangup", "text": "Ha! Nice try, pal!"},
  {"id": "c12_sale",   "voice": "c12", "kind": "sale",   "text": "Sold! I love it! What is it?"},
  {"id": "sup_welcome1", "voice": "sup", "kind": "sup_welcome", "text": "Welcome aboard. Your quota is on the screen."},
  {"id": "sup_welcome2", "voice": "sup", "kind": "sup_welcome", "text": "This is your supervisor. You may call me Supervisor."},
  {"id": "sup_met1",   "voice": "sup", "kind": "sup_met",    "text": "Quota met. Do not get used to it."},
  {"id": "sup_met2",   "voice": "sup", "kind": "sup_met",    "text": "Acceptable. Management is mildly aware of you."},
  {"id": "sup_met3",   "voice": "sup", "kind": "sup_met",    "text": "Good numbers. Keep them that way."},
  {"id": "sup_missed1", "voice": "sup", "kind": "sup_missed", "text": "Short again. Your chair is disappointed."},
  {"id": "sup_missed2", "voice": "sup", "kind": "sup_missed", "text": "Those numbers are a cry for help."},
  {"id": "sup_missed3", "voice": "sup", "kind": "sup_missed", "text": "We expected less, and you still missed."}
]
